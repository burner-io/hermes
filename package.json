{
  "name": "@tbachir/hermes",
  "version": "0.5.0",
  "private": false,
  "description": "Hermes-native TypeScript SDK with faithful management contracts, programmatic execution protocols, transport, React Query-compatible factories, and optional Vercel AI SDK tools.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Tarek Bachir",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbachir/hermes.git"
  },
  "bugs": {
    "url": "https://github.com/tbachir/hermes/issues"
  },
  "homepage": "https://github.com/tbachir/hermes#readme",
  "keywords": [
    "hermes",
    "sdk",
    "typescript",
    "mcp",
    "ai",
    "react-query",
    "vercel-ai-sdk"
  ],
  "files": [
    "dist",
    "README.md",
    "docs",
    "VALIDATION.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./react-query": {
      "types": "./dist/integrations/react-query.d.ts",
      "default": "./dist/integrations/react-query.js"
    },
    "./ai-sdk": {
      "types": "./dist/integrations/ai-sdk.d.ts",
      "default": "./dist/integrations/ai-sdk.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "ai": "^6.0.253",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.90.0 <6",
    "ai": ">=6.0.0 <7"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  }
}
